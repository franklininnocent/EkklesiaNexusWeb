# Example nginx vhosts for the intended EkklesiaNexus hostnames.
# TLS paths are placeholders — issue certificates after DNS exists.
# Do not enable these until the production document root and PHP-FPM socket are confirmed.

# --- Marketing: https://ekklesianexus.com ---
server {
    listen 80;
    server_name ekklesianexus.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ekklesianexus.com;

    # ssl_certificate     /etc/letsencrypt/live/ekklesianexus.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/ekklesianexus.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Bind Next.js to 127.0.0.1 only (e.g. next start -H 127.0.0.1). Do not expose :3000 publicly.

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Strip client-supplied country headers (never trust the browser).
        proxy_set_header CF-IPCountry "";
        proxy_set_header X-Country-Code "";
        proxy_set_header X-Vercel-IP-Country "";
        proxy_set_header CloudFront-Viewer-Country "";

        # Trusted visitor country from IP (pick one deployment mode):
        # A) Cloudflare in front of nginx:
        # proxy_set_header X-EN-Geo-Country $http_cf_ipcountry;
        # B) ngx_http_geoip2_module + GeoLite2-Country.mmdb on $remote_addr:
        # geoip2 /var/lib/ekklesia/geoip/GeoLite2-Country.mmdb { $geoip2_country_code country iso_code; }
        # proxy_set_header X-EN-Geo-Country $geoip2_country_code;

        # Must match MARKETING_GEO_HEADER_SECRET on the Next.js host.
        # proxy_set_header X-EN-Geo-Token "replace-with-long-random-secret";
    }
}

# --- Angular app: https://app.ekklesianexus.com ---
server {
    listen 80;
    server_name app.ekklesianexus.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name app.ekklesianexus.com;

    # ssl_certificate     /etc/letsencrypt/live/ekklesianexus.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/ekklesianexus.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    root /var/www/html/EkklesiaNexus/EkklesiaNexusUi/dist/ekklesia-soft-ui/browser;
    index index.html;

    # Signed media <img> tags may request /api/tenant/media/serve on this host when an
    # older UI bundle rewrites API URLs to same-origin paths. Proxy to the API vhost.
    location /api/ {
        proxy_pass https://api.ekklesianexus.com/api/;
        proxy_http_version 1.1;
        proxy_set_header Host api.ekklesianexus.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# --- API: https://api.ekklesianexus.com ---
server {
    listen 80;
    server_name api.ekklesianexus.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name api.ekklesianexus.com;

    # ssl_certificate     /etc/letsencrypt/live/ekklesianexus.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/ekklesianexus.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    root /var/www/html/EkklesiaNexus/EkklesiaNexusApi/public;
    index index.php;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
