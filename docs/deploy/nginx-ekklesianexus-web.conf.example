# Example reverse proxy for EkklesiaNexusWeb (Next.js on 127.0.0.1:3000).
# TLS certificates and domain names are environment-specific.

server {
    listen 443 ssl http2;
    server_name www.example.com;

    # ssl_certificate     /etc/ssl/certs/ekklesianexus-web.pem;
    # ssl_certificate_key /etc/ssl/private/ekklesianexus-web.key;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
