{
  "name": "ekklesianexus-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-marketing-content.ts",
    "validate:i18n": "tsx scripts/validate-i18n.ts",
    "generate:review-matrix": "tsx scripts/generate-review-matrix.ts",
    "test:unit": "tsx src/lib/application-entry.test.ts && tsx src/lib/contact-form-validation.test.ts && tsx src/lib/i18n/locale.test.ts && tsx src/lib/pricing-expand.test.ts && tsx src/lib/pricing/map-public-plans.test.ts && tsx src/data/regional-pricing.test.ts && tsx src/lib/marketing-money.test.ts && tsx src/lib/pricing/market-preference.test.ts && tsx src/lib/pricing/resolve-pricing-market.test.ts && tsx scripts/seo-metadata.test.ts && tsx scripts/robots-policy.test.ts && tsx src/lib/marketing/ga4-events.test.ts && tsx src/lib/api/rate-limit.test.ts && tsx src/lib/api/secrets.test.ts && tsx src/lib/marketing/ga4-id.test.ts && tsx src/lib/api/client-ip.test.ts",
    "test:e2e": "bash scripts/ensure-webkit-host-libs.sh && playwright test",
    "test:e2e:i18n-evidence": "bash scripts/ensure-webkit-host-libs.sh && playwright test e2e/i18n-evidence.spec.ts --project=chrome",
    "generate:og": "python3 scripts/generate-og-preview.py",
    "generate:brand-webp": "bash scripts/export-brand-webp.sh",
    "generate:product-webp": "bash scripts/export-product-webp.sh",
    "export:content": "tsx scripts/export-marketing-content-json.ts",
    "validate:export": "tsx scripts/validate-marketing-json.ts",
    "prepublish:cms": "bash scripts/pre-publish-cms.sh",
    "qa": "bash scripts/run-marketing-qa.sh",
    "smoke": "bash scripts/smoke-production.sh",
    "smoke:production-host": "bash scripts/smoke-production-host.sh",
    "verify:seo": "bash scripts/verify-seo-implementation.sh",
    "scan:security": "bash scripts/scan-marketing-security.sh",
    "prebuild": "npm run validate:content && npm run validate:i18n"
  },
  "dependencies": {
    "intl-messageformat": "^10.7.18",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
