# Server-only — never expose to the browser
LARAVEL_API_URL=http://127.0.0.1:8000

# Shared secret so Laravel can rate-limit by visitor IP instead of the Next.js egress IP.
# Must match the API MARKETING_BFF_SECRET. Required in production (fail-closed without it).
# MARKETING_BFF_SECRET=

# Set true only behind a reverse proxy that overwrites X-Forwarded-For / X-Real-IP.
# MARKETING_TRUST_PROXY=true

# Optional: force visitor country for pricing when CDN headers and GeoIP are unavailable (e.g. localhost in India).
# MARKETING_VISITOR_COUNTRY=IN

# Optional: Laravel calls this after marketing plan catalog publication (must match API MARKETING_REVALIDATE_SECRET)
# MARKETING_REVALIDATE_SECRET=

# Marketing content: file (V1) | api (V2 CMS — falls back to file until API returns data)
MARKETING_CONTENT_SOURCE=file
# MARKETING_CONTENT_API_PATH=/api/public/marketing-content
# MARKETING_CONTENT_STRICT=true

# Public site URL (canonical, sitemap, Open Graph)
# Production: https://ekklesianexus.com
# When unset in production, the site falls back to that official website.
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Optional contact display (hide line if unset in local development).
# Production falls back to contact@ekklesianexus.com.
MARKETING_CONTACT_EMAIL=
MARKETING_CONTACT_PHONE=
MARKETING_CONTACT_ADDRESS=

# Analytics off by default
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Parish application (Open Application links). Production falls back to https://app.ekklesianexus.com.
NEXT_PUBLIC_APPLICATION_URL=http://localhost:4200
# NEXT_PUBLIC_APPLICATION_URL=https://app.ekklesianexus.com
